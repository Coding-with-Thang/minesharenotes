# Copy to .env. Neon writes DATABASE_URL (pooled, app traffic) and
# DATABASE_URL_UNPOOLED (direct, migrations). DIRECT_URL is an optional fallback.

DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# openssl rand -base64 32
AUTH_SECRET=""

# Gmail address, app password, and the From header. No custom domain required.
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Shared secret Vercel sends as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
